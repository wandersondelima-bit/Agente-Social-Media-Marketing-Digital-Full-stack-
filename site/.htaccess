# Raiz de marceloosawaimoveis.com.br: site estático (página inicial + páginas de imóveis em /{codigo}/{bairro}/).

DirectoryIndex index.html
AddDefaultCharset UTF-8
Options -Indexes

# Endereço inexistente mostra a página 404 do site, não a do servidor
ErrorDocument 404 /404.html

# Sempre HTTPS e sem www
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://marceloosawaimoveis.com.br%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
